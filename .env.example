# Token City — environment variable names (task8 §17).
# Copy to .env.local for development. Never commit real values.
# Vercel and Convex hold the real values as encrypted environment variables.

# ── Convex (durable state and realtime) ─────────────────────────────────────
# Browser deployment URL.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Same URL, read by Vercel Functions at runtime.
CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# ── Protected operations console ────────────────────────────────────────────
TOKEN_CITY_ADMIN_PASSWORD=
TOKEN_CITY_ADMIN_SESSION_SECRET=
# Shared secret for Vercel Function -> Convex admin calls. Set the SAME value in
# the Convex deployment environment.
CHAIN_SERVICE_SECRET=

# ── Robinhood Chain ─────────────────────────────────────────────────────────
# Optional override. Leave empty: Development and Preview resolve to testnet
# 46630 and Production resolves to mainnet 4663 from VERCEL_ENV.
RHC_ENVIRONMENT=
# Production provider endpoints (Convex deployment environment). The public
# rate-limited RPC is the fallback and is acceptable for development only.
RHC_RPC_HTTP_URL_TESTNET=
RHC_RPC_HTTP_URL_MAINNET=
RHC_RPC_WS_URL_TESTNET=
RHC_RPC_WS_URL_MAINNET=
# Withdrawal signer. A raw key is acceptable for development and testnet only;
# production must use the approved managed signer (§13.3).
RHC_SIGNER_PRIVATE_KEY=
RHC_SIGNER_REFERENCE=
RHC_ALLOW_ENV_SIGNER_ON_MAINNET=
# Provider webhook receiver and protected reconciliation endpoint.
RHC_PROVIDER_WEBHOOK_SECRET=
RHC_RECONCILIATION_SECRET=

# ── Optional wallet support ─────────────────────────────────────────────────
# WalletConnect project id. Without it the WalletConnect option is hidden.
WALLETCONNECT_PROJECT_ID=

# ── Legacy Solana values (read-only during the migration, §19.1) ────────────
# Kept so historical pool and contract-address records remain readable.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
TOKEN_CITY_DEVNET_POOL_B64=
